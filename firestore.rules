rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /campaigns/{campaignId} {
      // The campaign doc itself: whoever writes it first (via the DM Remote's
      // Campaigns panel) becomes its owner. After that, only they can rename
      // it or otherwise touch this document.
      allow read: if request.auth != null;
      allow create: if request.auth != null
                     && request.resource.data.ownerId == request.auth.uid;
      // Update is allowed if you're already the owner, OR the doc predates
      // ownership tracking (no ownerId field yet) — letting the first person
      // to reconnect after this update claim it, same as a fresh campaign.
      allow update, delete: if request.auth != null
                     && (resource.data.ownerId == request.auth.uid
                         || !('ownerId' in resource.data));

      // Player characters: anyone signed in can read (DM + fellow players),
      // but a player can only create/edit/delete their OWN character.
      match /characters/{characterId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                       && request.resource.data.ownerId == request.auth.uid;
        allow update, delete: if request.auth != null
                       && resource.data.ownerId == request.auth.uid;
      }

      // DM-only campaign content: the Campaign Database (NPCs/Cities/Quests/
      // Rumors) and Session Notes are only readable/writable by the campaign's
      // owning DM account — players never read these from the app.
      match /entries/{docId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerId == request.auth.uid;
      }
      match /sessionNotes/{docId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerId == request.auth.uid;
      }
      match /roster/{docId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerId == request.auth.uid;
      }

      // Session Save/Load cloud slot: the TV overlay writes this anonymously
      // (it isn't signed in as you), so this stays open to any signed-in
      // session rather than owner-restricted. It's just a save-game blob,
      // not identity-bearing data — ask if you'd like this tightened too.
      match /sessions/{docId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
