rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /campaigns/{campaignId} {
      // Anyone signed in can read and write campaign metadata, and everything in
      // the DM-only collections below — DM access is granted by knowing the
      // campaign code itself, not by a specific Google account. This lets anyone
      // (co-DMs, a friend running one-shots, whoever) pick up the DM Remote for
      // this campaign without being locked out.
      allow read, write: if request.auth != null;

      // Player characters are the one exception: anyone signed in can read them
      // (DM + fellow players), but a player can only create/edit/delete their OWN
      // character — this is unrelated to who's allowed to be DM.
      match /characters/{characterId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                       && request.resource.data.ownerId == request.auth.uid;
        allow update, delete: if request.auth != null
                       && resource.data.ownerId == request.auth.uid;
      }

      match /entries/{docId} {
        allow read, write: if request.auth != null;
      }
      match /sessionNotes/{docId} {
        allow read, write: if request.auth != null;
      }
      match /roster/{docId} {
        allow read, write: if request.auth != null;
      }
      match /sessions/{docId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
